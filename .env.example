# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── API ──────────────────────────────────────────────────────────────────────
# Backend API base URL (server-side, no VITE_ prefix)
API_BASE_URL=http://localhost:3001

# Backend API base URL (client-side, must start with VITE_)
VITE_API_BASE_URL=http://localhost:3001

# ─── Map Provider ─────────────────────────────────────────────────────────────
# Supported: mapbox | google
VITE_MAP_PROVIDER=mapbox
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# ─── Cloudflare Turnstile (Bot Protection) ────────────────────────────────────
# Get from: https://dash.cloudflare.com -> Turnstile
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# ─── Analytics (PostHog) ──────────────────────────────────────────────────────
# Get from: https://app.posthog.com -> Project Settings
VITE_POSTHOG_KEY=phc_your_posthog_key_here
VITE_POSTHOG_HOST=https://app.posthog.com

# ─── Error Tracking (Sentry) ──────────────────────────────────────────────────
# Get from: https://sentry.io -> Project -> Settings -> Client Keys (DSN)
VITE_SENTRY_DSN=https://your_key@sentry.io/your_project_id

# ─── Brand / Feature Flags ────────────────────────────────────────────────────
VITE_BRAND_URL=https://lastly.in

# ─── Notes ────────────────────────────────────────────────────────────────────
# 1. Never commit the actual .env file — only .env.example
# 2. Duplicate this file to .env and fill in real values for local dev
# 3. Add production values via your hosting provider's secret management
# 4. VITE_ prefix = exposed to browser bundle. Use for public keys only.
#    Variables without VITE_ are server-only (SSR) and never sent to the client.
